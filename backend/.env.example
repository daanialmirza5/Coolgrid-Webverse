ENV=development

# PostgreSQL/PostGIS connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://coolgrid:coolgrid_dev_password@localhost:5432/coolgrid

# JWT auth -- generate a real secret for anything beyond local demo use,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo account created by the seed script so the app is demoable without
# manual registration.
DEMO_USER_EMAIL=demo@coolgrid.app
DEMO_USER_PASSWORD=CoolGrid#Demo2026
DEMO_ADMIN_EMAIL=admin@coolgrid.app
DEMO_ADMIN_PASSWORD=CoolGrid#Admin2026
