# Root-level env vars consumed by docker-compose.yml for the PostgreSQL/PostGIS
# container. All have working defaults baked into docker-compose.yml, so this
# file is optional for local development -- override here only if you need
# non-default credentials/ports.

POSTGRES_USER=coolgrid
POSTGRES_PASSWORD=coolgrid_dev_password
POSTGRES_DB=coolgrid
POSTGRES_PORT=5432

# Backend and frontend each have their own .env.example with the variables
# they actually read -- see backend/.env.example and frontend/.env.example.
